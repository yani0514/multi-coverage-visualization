{
  "name": "multi-coverage-visualization",
  "displayName": "Multi Coverage Visualization",
  "description": "Visualize and compare multiple code coverage files in VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "multi-coverage-visualization.configurePairwise", "title": "Multi Coverage: Configure Pairwise Comparison" },
      { "command": "multi-coverage-visualization.configureMultiplicity", "title": "Multi Coverage: Configure N-of-M Filter" },
      { "command": "multi-coverage-visualization.useStandardComparison", "title": "Multi Coverage: Use Comparison / Focus" },
      { "command": "multi-coverage-visualization.selectPairwiseSource", "title": "Multi Coverage: Select Pairwise Source" },
      { "command": "multi-coverage-visualization.setPairwiseOperation", "title": "Multi Coverage: Set Pairwise Operation" },
      {
        "command": "multi-coverage-visualization.toggleDisplayOption",
        "title": "Multi Coverage: Toggle Display Option"
      },
      {
        "command": "multi-coverage-visualization.setFocusSource",
        "title": "Multi Coverage: Set Focus Source"
      },
      {
        "command": "multi-coverage-visualization.showOnlyCoverageSource",
        "title": "Show Only This Source"
      },
      {
        "command": "multi-coverage-visualization.configurePathMapping",
        "title": "Multi Coverage: Configure Path Mapping",
        "icon": "$(settings-gear)"
      },
      {
        "command": "multi-coverage-visualization.loadCoverage",
        "title": "Multi Coverage: Load Coverage File",
        "icon": "$(add)"
      },
      {
        "command": "multi-coverage-visualization.setComparisonMode",
        "title": "Multi Coverage: Set Comparison Mode"
      },
      {
        "command": "multi-coverage-visualization.toggleCoverageSource",
        "title": "Multi Coverage: Toggle Coverage Source"
      },
      {
        "command": "multi-coverage-visualization.enableAllCoverageSources",
        "title": "Multi Coverage: Enable All Coverage Sources",
        "icon": "$(check-all)"
      },
      {
        "command": "multi-coverage-visualization.disableAllCoverageSources",
        "title": "Multi Coverage: Disable All Coverage Sources",
        "icon": "$(circle-slash)"
      },
      {
        "command": "multi-coverage-visualization.removeCoverageSource",
        "title": "Multi Coverage: Remove Coverage Source",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multiCoverage",
          "title": "Multi Coverage",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "multiCoverage": [
        {
          "id": "multiCoverage.sources",
          "name": "Coverage Sources",
          "icon": "resources/icon.svg"
        },
        {
          "id": "multiCoverage.comparison",
          "name": "Comparison",
          "icon": "resources/icon.svg"
        },
        {
          "id": "multiCoverage.focusSource",
          "name": "Focus Source",
          "icon": "resources/icon.svg"
        },
        {
          "id": "multiCoverage.currentFile",
          "name": "Current File",
          "icon": "resources/icon.svg"
        },
        {
          "id": "multiCoverage.display",
          "name": "Display",
          "icon": "resources/icon.svg"
        },
        {
          "id": "multiCoverage.advancedComparison",
          "name": "Advanced Comparison",
          "icon": "resources/icon.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "multiCoverage.sources",
        "contents": "No coverage files loaded.\n[Load Coverage File](command:multi-coverage-visualization.loadCoverage)"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "multi-coverage-visualization.selectPairwiseSource", "when": "false" },
        { "command": "multi-coverage-visualization.setPairwiseOperation", "when": "false" },
        {
          "command": "multi-coverage-visualization.toggleDisplayOption",
          "when": "false"
        },
        {
          "command": "multi-coverage-visualization.setFocusSource",
          "when": "false"
        },
        {
          "command": "multi-coverage-visualization.showOnlyCoverageSource",
          "when": "false"
        },
        {
          "command": "multi-coverage-visualization.setComparisonMode",
          "when": "false"
        },
        {
          "command": "multi-coverage-visualization.toggleCoverageSource",
          "when": "false"
        },
        {
          "command": "multi-coverage-visualization.removeCoverageSource",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "multi-coverage-visualization.configurePathMapping",
          "when": "view == multiCoverage.sources",
          "group": "2_configuration@1"
        },
        {
          "command": "multi-coverage-visualization.loadCoverage",
          "when": "view == multiCoverage.sources",
          "group": "navigation@1"
        },
        {
          "command": "multi-coverage-visualization.enableAllCoverageSources",
          "when": "view == multiCoverage.sources && multiCoverage.hasSources",
          "group": "1_state@1"
        },
        {
          "command": "multi-coverage-visualization.disableAllCoverageSources",
          "when": "view == multiCoverage.sources && multiCoverage.hasSources",
          "group": "1_state@2"
        }
      ],
      "view/item/context": [
        {
          "command": "multi-coverage-visualization.showOnlyCoverageSource",
          "when": "view == multiCoverage.sources && viewItem == coverageSource",
          "group": "1_state@1"
        },
        {
          "command": "multi-coverage-visualization.removeCoverageSource",
          "when": "view == multiCoverage.sources && viewItem == coverageSource",
          "group": "1_modification@1"
        }
      ]
    }
  },
  "scripts": {
    "test:unit": "npm run compile-tests && node node_modules/mocha/bin/mocha.js --ui tdd out/test/workspaceConfig.test.js out/test/parser.test.js out/test/pathResolver.test.js out/test/comparisonFilter.test.js out/test/focusComparison.test.js out/test/advancedComparison.test.js out/test/coverageAnalysis.test.js",
    "benchmark": "npm run compile-tests && node --expose-gc benchmarks/coverage-benchmark.cjs",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
